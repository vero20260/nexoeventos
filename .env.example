# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo como .env en la raíz del proyecto y configure sus credenciales:
#   cp .env.example .env
#
# NOTA SEGÚN DOCUMENTO P2:
# - La cadena de conexión debe estar en una variable de entorno o archivo .env,
#   NUNCA quemada (hardcodeada) en el código.
# ==============================================================================

# Credenciales de conexión a PostgreSQL
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexoeventos_db

# URL de conexión SQLAlchemy completa:
# postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>|<DB_NAME>
DATABASE_URL=postgresql://postgres:tu_contraseña_aqui@localhost:5432/nexoeventos_db

# Configuración del servidor API
API_HOST=127.0.0.1
API_PORT=8000
